+#include <system_data_ta.h>
+
+#define TA_UUID				TA_SYSTEM_DATA_UUID
+
+#define TA_FLAGS			TA_FLAG_SINGLE_INSTANCE | TA_FLAG_DEVICE_ENUM_TEE_STORAGE_PRIVATE
+
+#define TA_STACK_SIZE			(2 * 1024)
+#define TA_DATA_SIZE			(32 * 1024)
+
